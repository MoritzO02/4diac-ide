<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="F_ADD" Comment="Adds two number values" >
	<Identification Standard="61131-3" Classification="standard arithmetic function" Description="Copyright (c) 2011 TU Wien ACIN  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0" >
	</Identification>
	<VersionInfo Organization="TU Wien ACIN" Version="1.0" Author="Monika Wenger" Date="2011-09-22">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="Normal Execution Request" >
				<With Var="IN1"/>
				<With Var="IN2"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="Execution Confirmation" >
				<With Var="OUT"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="IN1" Type="ANY_MAGNITUDE" Comment="First funtion input" />
			<VarDeclaration Name="IN2" Type="ANY_MAGNITUDE" Comment="Second function input" />
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="OUT" Type="ANY_MAGNITUDE" Comment="IN1 plus IN2" />
		</OutputVars>
	</InterfaceList>
</FBType>
