<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="E_F_TRIG" Comment="Boolean falling edge detection" >
	<Identification Standard="61499-1 Annex A" Description="Copyright (c) 2017 fortiss GmbH  &#10; &#10;This program and the accompanying materials are made  &#10;available under the terms of the Eclipse Public License 2.0  &#10;which is available at https://www.eclipse.org/legal/epl-2.0/  &#10; &#10;SPDX-License-Identifier: EPL-2.0" >
	</Identification>
	<VersionInfo Organization="fortiss GmbH" Version="1.0" Author="Alois Zoitl" Date="2017-09-22" Remarks="initial API and implementation and/or initial documentation">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="EI" Type="Event" Comment="check for falling edge" >
				<With Var="QI"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="EO" Type="Event" Comment="confirmation that an falling edge was detected" >
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="QI" Type="BOOL" Comment="value to check for a falling edge" />
		</InputVars>
	</InterfaceList>
	<FBNetwork>
		<FB Name="E_D_FF" Type="E_D_FF" x="780" y="100">
		</FB>
		<FB Name="E_SWITCH" Type="E_SWITCH" x="1400" y="100">
		</FB>
		<EventConnections>
			<Connection Source="EI" Destination="E_D_FF.CLK" dx1="560"/>
			<Connection Source="E_D_FF.EO" Destination="E_SWITCH.EI"/>
			<Connection Source="E_SWITCH.EO0" Destination="EO" dx1="6241.18"/>
		</EventConnections>
		<DataConnections>
			<Connection Source="QI" Destination="E_D_FF.D" dx1="70.59" dx2="70.59" dy="-29.41"/>
			<Connection Source="E_D_FF.Q" Destination="E_SWITCH.G" dx1="70.59" dx2="70.59" dy="47.06"/>
		</DataConnections>
	</FBNetwork>
</FBType>
